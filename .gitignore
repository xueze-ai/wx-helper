# ---------------------------------------------------------------------------
/build/
/dist/
/_internal/
/release/
*.exe
*.dll
!native/build/selftest_bridge.dll
!native/build_text/text_bridge.dll
native/.build/
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.manifest
*.spec
*.zip
*.7z
*.rar

